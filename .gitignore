# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
dist-web/
web-build/
expo-env.d.ts

# Tamagui
.tamagui/

# Native / mobile signing (never commit secrets)
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
local.properties

# generated native folders (use `npx expo prebuild` locally)
/ios
/android

# EAS (Expo Application Services)
.eas/
credentials.json
*.apk
*.aab
*.ipa

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
*.log

# test coverage
coverage/
*.lcov
.nyc_output

# typescript
*.tsbuildinfo

# local env files (keep .env.example if you add one)
.env
.env.*
!.env.example

# caches & temp
.cache/
.turbo/
tmp/
temp/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDE / editor (machine-specific)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cursor/
.claude/
*.swp
*.sublime-*

# Xcode (if ios/ is generated locally)
xcuserdata/
*.xcuserstate
*.xcworkspace
!default.xcworkspace

# Android (if android/ is generated locally)
*.hprof
